{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/external/bin/x64;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build"
        }
    ]
}